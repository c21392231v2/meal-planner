<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main id="main-content" class="dashboard-page">
        <section class="dashboard-header">
            <h1>Dashboard</h1>
        </section>
    </main>

    <form action="/logout" method="POST">
        <button type="submit">Log out</button>
    </form>

    <p> Welcome, <%= username %> ! </p>
    
    <h2>Add a Meal</h2>

<form action="/meals" method="POST">

    <div>
        <label for="title">Meal</label>
        <input
            type="text"
            id="title"
            name="title"
            maxlength="150"
            required
        >
    </div>

    <div>
        <label for="meal_day">Day</label>

        <select id="meal_day" name="meal_day" required>
            <option value="">Select day</option>
            <option value="Monday">Monday</option>
            <option value="Tuesday">Tuesday</option>
            <option value="Wednesday">Wednesday</option>
            <option value="Thursday">Thursday</option>
            <option value="Friday">Friday</option>
            <option value="Saturday">Saturday</option>
            <option value="Sunday">Sunday</option>
        </select>
    </div>

    <div>
        <label for="time_of_day">Meal Type</label>

        <select id="time_of_day" name="time_of_day" required>
            <option value="">Select meal type</option>
            <option value="Breakfast">Breakfast</option>
            <option value="Lunch">Lunch</option>
            <option value="Dinner">Dinner</option>
        </select>
    </div>

    <button type="submit">Add Meal</button>

</form>

<!--CURRENT MEALS-->
<section class="meal-list-section">
    <h2>My Meals</h2>

    <% if (meals && meals.length > 0) { %>
        <% meals.forEach(meal => { %>
            <article class="meal-card">
                <h3>
                    <%= meal.title %>
                </h3>

                <p>
                    <%= meal.meal_day %>
                </p>

                <p>
                    <%= meal.time_of_day %>
                </p>

                <!--VIEW-->
                <a href="/meals/<%= meal.meal_id %>">
                    View
                </a>

                <!--EDIT-->
                <a href="/meals/<%= meal.meal_id %>/edit">
                    Edit
                </a>

                <!--DELETE-->
                <form action="/meals/<%=meal.meal_id%>/delete" method="POST">
                    <button type="submit">
                        Delete
                    </button>
                </form>

            </article>
       <% }) %>

       <% } else { %>
        <p> 
            No meals planned yet
        </p>
      <% } %>
</section>
</body>
</html>