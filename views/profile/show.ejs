<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>

<body>
  <main class="profile-page">
    <section class="profile-card">
      <p class="eyebrow">Your personal details</p>

      <h1>My profile</h1>

      <dl class="profile-details">
        <div>
          <dt>Name</dt>
          <dd><%= user.username %></dd>
        </div>

        <div>
          <dt>Email</dt>
          <dd><%= user.email %></dd>
        </div>
      </dl>

      <div class="profile-actions">
        <a
          href="/profile/edit"
          class="button primary-button"
        >
          Edit profile
        </a>

        <a
          href="/profile/password"
          class="button secondary-button"
        >
          Change password
        </a>
      </div>

      <section class="danger-zone">
        <h2>Delete account</h2>

        <p>
          This permanently deletes your profile, recipes and
          favourites. This action cannot be reversed.
        </p>

        <form
          action="/profile/delete"
          method="POST"
          onsubmit="return confirm(
            'Delete your account permanently?'
          );"
        >
          <button type="submit" class="button danger-button">
            Delete account
          </button>
        </form>
      </section>
    </section>
  </main>
</body>
</html>